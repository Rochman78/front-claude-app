ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
FRONT_API_TOKEN=your-frontapp-token-here

# Auto-draft des devis (cron Render polling /api/plugin/auto-draft-poll)
AUTO_DRAFT_SECRET=long-random-string

# AUTO_SEND_ENABLED=true → l'auto-draft des devis ENVOIE le mail direct au client
# (au lieu de juste poser un brouillon).
# Si false ou absent (défaut), comportement historique : on pose juste un brouillon
# que l'équipe relit avant envoi. Toggle = kill switch en cas de souci, pas besoin
# de revert de code.
AUTO_SEND_ENABLED=false
